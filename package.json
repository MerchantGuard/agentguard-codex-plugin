{
  "name": "@agentguard-run/codex-plugin",
  "version": "0.3.4",
  "description": "Local tool policy hooks and content-free signed records for Codex, ChatGPT Work and Claude Code.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --require ./tests/helper-notifications.cjs --test --test-concurrency=1 tests/*.test.cjs",
    "start": "node runtime/mcp.cjs",
    "build:compat": "node scripts/build-compat.cjs",
    "check:compat": "node scripts/build-compat.cjs --check",
    "postinstall": "node scripts/provision-dependencies.cjs",
    "test:claude": "AGENTGUARD_TEST_HOST=claude-code node --require ./tests/helper-notifications.cjs --test --test-concurrency=1 tests/*.test.cjs",
    "test:hosts": "npm test && npm run test:claude"
  },
  "dependencies": {
    "@agentguard-run/spend": "^0.20.0",
    "@agentguard-run/burn": "^0.2.3"
  },
  "files": [
    "plugin.json",
    "mcp.json",
    ".app.json",
    "hooks",
    "runtime",
    "config",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts",
    "compat",
    ".agents/plugins/marketplace.json",
    "docs",
    ".claude-plugin",
    ".mcp.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MerchantGuard/agentguard-codex-plugin.git"
  },
  "homepage": "https://agentguard.run"
}
