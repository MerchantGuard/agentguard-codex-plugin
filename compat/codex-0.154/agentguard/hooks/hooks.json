{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/burn-gate.cjs\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/spend-gate.cjs\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/receipt.cjs\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
